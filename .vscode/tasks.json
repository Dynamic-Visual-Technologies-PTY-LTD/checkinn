{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "install",
      "type": "npm",
      "script": "install",
      "problemMatcher": []
    },
    {
      "label": "dev",
      "type": "npm",
      "script": "dev",
      "isBackground": true,
      "problemMatcher": {
        "owner": "next-dev",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Next\\.js",
          "endsPattern": "Ready in"
        }
      },
      "presentation": { "group": "dev", "reveal": "always" }
    },
    {
      "label": "lint",
      "type": "npm",
      "script": "lint",
      "problemMatcher": ["$eslint-stylish"]
    },
    {
      "label": "typecheck",
      "type": "npm",
      "script": "typecheck",
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "test",
      "type": "npm",
      "script": "test",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "test: watch",
      "type": "npm",
      "script": "test:watch",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "group": "dev", "reveal": "always" }
    },
    {
      "label": "build",
      "type": "npm",
      "script": "build",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "verify",
      "detail": "Lint, typecheck, test and build: the same checks CI runs",
      "dependsOn": ["lint", "typecheck", "test", "build"],
      "dependsOrder": "sequence",
      "problemMatcher": []
    }
  ]
}
