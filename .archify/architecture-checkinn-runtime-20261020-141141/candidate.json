  "cards": [
    { "dot": "emerald", "title": "Primary path: confirm a booking", "items": [
      "Booking form calls confirmBooking with the /book idempotency key",
      "createBooking re-checks rooms, availability and price in one SQLite transaction",
      "Redirect to /bookings/<reference> only after commit"
    ] },
    { "dot": "rose", "title": "Trust boundary rules", "items": [
      "Every action re-parses client criteria through the URL codec",
      "checkinn_access cookie holds booking tokens: httpOnly, SameSite=Lax, not Secure (expo serves HTTP)",
      "Cancel needs the token in the cookie; Manage lookup needs reference + email",
      "Logs carry error name and code only, never query, email or token"
    ] },
    { "dot": "amber", "title": "Smart search is optional", "items": [
      "No Provider configured: no Smart search box, the app is the MVP",
      "CHECKINN_PROVIDER=fake answers from fixtures, for e2e only",
      "Provider output is untrusted; applyInterpretation validates it",
      "Timeout or Provider error keeps the current criteria"
    ] },
    { "dot": "slate", "title": "Not drawn", "items": [
      "Pure rules in src/domain are used by every server node",
      "Seed JSON loads into an empty database; npm run db:reset restores it",
      "embed() and reasons() are called only by scripts/search-preflight.ts today"
    ] }
