# Copy to .env.local and fill in. Nothing is required to run CheckInn: with
# no Provider configured, Smart search is off and the app is the MVP.
# Never commit a filled-in copy.

# Smart search Provider: azure (the default when all four Azure variables
# are set), fake (fixtures, for e2e only), or off.
CHECKINN_PROVIDER=

# Azure AI Foundry, OpenAI v1 API. Smart search needs all four.
# Base URL: https://<resource>.openai.azure.com/openai/v1/
AZURE_OPENAI_BASE_URL=
AZURE_OPENAI_API_KEY=
# The gpt-6-luna deployment name
AZURE_OPENAI_CHAT_DEPLOYMENT=
# The text-embedding-3-large deployment name
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=

# 1 shows the Score breakdown on listing cards.
CHECKINN_SEARCH_DEBUG=
