# Copy to .env.local and fill in. Nothing is required to run CheckInn: with
# no Provider configured, Smart search is off and the app is the MVP.
# Never commit a filled-in copy.

# Smart search Provider: azure (the default when all four Azure variables
# are set), fake (fixtures, for e2e only), or off.
CHECKINN_PROVIDER=

# Azure AI Foundry, OpenAI v1 API.
# Endpoint: https://<resource>.openai.azure.com/ (/openai/v1/ is added)
AZURE_OPENAI_ENDPOINT=
# How to sign in:
# - key (the default, for local development);
# - azure-cli (local development without a key: uses the account from
#   `az login`, which needs the Cognitive Services OpenAI User role on the
#   resource);
# - managed-identity (on Azure; the identity needs the same role).
AZURE_OPENAI_AUTH=
# Needed only for key auth.
AZURE_OPENAI_API_KEY=
# Only for a user-assigned managed identity: its client ID.
AZURE_CLIENT_ID=
# The gpt-6-luna deployment name
AZURE_OPENAI_CHAT_DEPLOYMENT=
# The text-embedding-3-large deployment name
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=

# 1 shows the Score breakdown on listing cards.
CHECKINN_SEARCH_DEBUG=
